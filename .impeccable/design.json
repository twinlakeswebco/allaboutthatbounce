  "narrative": {
    "northStar": "The Party Invitation",
    "overview": "The Party Invitation is the working metaphor for this playful, saturated, bubbly and clean system. Bold rounded-feeling system type, pill actions, warm paper, purple emphasis, yellow bands and aqua artwork framing carry the invitation into a readable request flow and simple owner tools.\n\nThis is a source-derived record of the scoped frontend demo, sampled from public/styles.css and public/index.html, public/book.html and public/admin.html. Purple, yellow and aqua remain provisional brand choices; the logo, artwork, inventory and reviews contain explicit placeholders. Source review was followed by scoped visual and functional demo verification: five public routes at 360px had no overflow or page errors, mobile route screenshots and desktop Home were inspected, and the demo was approved to ship after two spacing fixes. This evidence covers the reviewed demo surfaces, not production readiness or every device and state.",
    "keyCharacteristics": [
      "Saturated accents on warm paper and white surfaces.",
      "Bold headings, pill actions and softly rounded forms.",
      "Mobile-first stacked content with one desktop breakpoint.",
      "Centralized CSS color variables and a local system font stack."
    ],
    "rules": [],
    "dos": [
      "Do reuse public/styles.css variables for shared colors, the font stack and the shared surface radius.",
      "Do preserve the 360px phone target, stacked mobile flow, wrapping actions and visible keyboard focus.",
      "Do keep marketing playful while forms and owner tools remain readable.",
      "Do label provisional imagery, demo data and request-only behavior honestly."
    ],
    "donts": [
      "Don't add unnecessary third-party fonts or scripts.",
      "Don't extend scoped demo verification into claims of production readiness or exhaustive device coverage.",
      "Don't treat the provisional palette or placeholder logo as approved final identity."
    ]
  }
}
