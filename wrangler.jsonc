{
  "name": "allaboutthatbounce",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "allaboutthatbounce",
      "database_id": "87feba55-c816-4f50-8413-80773f2d718f",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "allaboutthatbounce-photos",
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "vars": {
    "OWNER_EMAIL": "allaboutthatbounce7596@gmail.com",
    "FROM_EMAIL": "All About That Bounce <bookings@example.com>",
    "SITE_ORIGIN": "https://example.com",
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_AUD",
    "ADMIN_EMAILS": "owner@example.com",
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY",
  },
}
