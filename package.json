{
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:worker && npm run test:frontend",
    "format": "prettier --write \"worker/**/*.js\" \"public/**/*.{html,css,js}\" \"tests/**/*.mjs\" test-api.mjs wrangler.jsonc vitest.config.mjs \"frontend-tests/**/*.mjs\"",
    "format:check": "prettier --check \"worker/**/*.js\" \"public/**/*.{html,css,js}\" \"tests/**/*.mjs\" test-api.mjs wrangler.jsonc vitest.config.mjs \"frontend-tests/**/*.mjs\"",
    "test:smoke": "node test-api.mjs",
    "test:worker": "vitest run --reporter=verbose",
    "test:frontend": "node --experimental-vm-modules --test frontend-tests/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "vitest": "~3.2.0"
  }
}
